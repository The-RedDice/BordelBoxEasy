# Token du bot Discord (trouvable sur https://discord.com/developers/applications)
DISCORD_TOKEN=TON_TOKEN_ICI

# ID de l'application / client Discord
DISCORD_CLIENT_ID=TON_CLIENT_ID_ICI

# ID du serveur Discord (optionnel pour enregistrement instantané des slash commands)
DISCORD_GUILD_ID=

# Port du serveur local (par défaut 3000)
PORT=3000

# Durée maximale en secondes par média (pour éviter qu'une vidéo de 10 min bloque tout)
MAX_MEDIA_DURATION=20

# Volume par défaut (entre 0.0 et 1.0)
DEFAULT_VOLUME=0.8
